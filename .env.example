# Copy to .env for local `uv run --locked python main.py`.
# This file contains placeholders only. Do not put real secrets in version control.

# Optional Notion source
NOTION_API_KEY=

# Optional Tistory source
TISTORY_BLOG_NAME=

# Optional GitHub source
CONTEXTWIKI_GITHUB_REPOSITORIES=
CONTEXTWIKI_GITHUB_DEFAULT_REF=main
GITHUB_TOKEN=
CONTEXTWIKI_GITHUB_MAX_FILES=200
CONTEXTWIKI_GITHUB_MAX_FILE_BYTES=512000
CONTEXTWIKI_GITHUB_USER_AGENT=ContextWikiBot/0.1 (+https://github.com/eunhwa99/MCPContentSearch)

# Optional Obsidian source
# Set to an absolute local path for direct host launch, or to a container path
# such as /vault when using Docker with a bind mount.
CONTEXTWIKI_OBSIDIAN_VAULT_PATH=
CONTEXTWIKI_OBSIDIAN_MAX_FILES=2000
CONTEXTWIKI_OBSIDIAN_MAX_FILE_BYTES=512000

# Common live runtime requirement:
# the current default embedding path typically needs OPENAI_API_KEY even when
# query rewrite stays disabled. demo.sh is the keyless path.
OPENAI_API_KEY=

# Optional search query rewrite. Keep disabled unless you intentionally allow
# external query-text egress to the configured provider. This path also uses
# OPENAI_API_KEY when the provider is OpenAI.
CONTEXTWIKI_SEARCH_LLM_ENABLED=false
CONTEXTWIKI_SEARCH_LLM_PROVIDER=openai
CONTEXTWIKI_SEARCH_LLM_MODEL=gpt-4.1-mini
CONTEXTWIKI_SEARCH_LLM_TIMEOUT=10.0
CONTEXTWIKI_SEARCH_LLM_MAX_REWRITES=3
